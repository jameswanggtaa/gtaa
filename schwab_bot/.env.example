# Copy to schwab_bot/.env and fill in values from developer.schwab.com
# Never commit real secrets.

SCHWAB_APP_KEY=
SCHWAB_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCOUNT_HASH=

# Optional token cache (refresh token may rotate)
SCHWAB_TOKEN_PATH=schwab_bot/.tokens.json

# Bot behavior — keep DRY_RUN=true until you intentionally go live
DRY_RUN=true
SCHWAB_SYMBOL=SPY
SCHWAB_QTY=1
SCHWAB_POLL_SEC=60
SCHWAB_MAX_NOTIONAL=2000
SCHWAB_MAX_SHARES=50
SCHWAB_MAX_OPEN_POSITIONS=3
SCHWAB_ALLOW_SHORT=false
LOG_LEVEL=INFO
