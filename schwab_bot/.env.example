# Copy to schwab_bot/.env and fill in values from developer.schwab.com
# Never commit real secrets.

SCHWAB_APP_KEY=
SCHWAB_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_REFRESH_TOKEN=
SCHWAB_ACCOUNT_HASH=

# Optional token cache (refresh token may rotate)
SCHWAB_TOKEN_PATH=schwab_bot/.tokens.json

# Bot behavior — keep DRY_RUN=true until you intentionally go live
DRY_RUN=true
STRATEGY=short_otm_call
# Comma-separated liquid names (examples only — use your universe)
SCHWAB_SYMBOLS=SPY,QQQ,AAPL,MSFT
SCHWAB_CONTRACTS=1
SCHWAB_POLL_SEC=60

# Short OTM call rules (~5 weeks, delta < 0.30)
SCHWAB_TARGET_DTE=35
SCHWAB_DTE_TOLERANCE=7
SCHWAB_MAX_DELTA=0.30
SCHWAB_MANAGE_DELTA=0.40
SCHWAB_MIN_IV=15
SCHWAB_MAX_IV=45
SCHWAB_MIN_OI=100
SCHWAB_MIN_VOLUME=10
SCHWAB_MAX_SPREAD_PCT=0.15

# Risk caps
SCHWAB_MAX_SHORT_CONTRACTS=2
SCHWAB_MAX_COVER_NOTIONAL=50000
SCHWAB_MAX_NOTIONAL=2000
SCHWAB_MAX_SHARES=50
SCHWAB_MAX_OPEN_POSITIONS=3
SCHWAB_ALLOW_SHORT=false

# Legacy equity SMA path: STRATEGY=equity_sma + SCHWAB_SYMBOL / SCHWAB_QTY
SCHWAB_SYMBOL=SPY
SCHWAB_QTY=1
LOG_LEVEL=INFO
